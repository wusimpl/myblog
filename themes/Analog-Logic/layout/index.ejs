<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-left">
      <h1 class="hero-slogan"><%= theme.bio || '爱真理，爱智慧' %></h1>
      <p class="hero-subtitle">Code · Music · Philosophy</p>
    </div>
    <div class="hero-right">
      <!-- 动态卡片区域 -->
      <div class="dynamic-cards">
        <div class="dynamic-card github-card">
          <div class="card-header">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            <span>Recent Activity</span>
          </div>
          <div class="card-body">
            <code class="commit-msg">feat: implement new feature</code>
            <span class="commit-time">2 hours ago</span>
          </div>
        </div>
        
        <div class="dynamic-card music-card">
          <div class="card-header">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            <span>Now Playing</span>
          </div>
          <div class="card-body">
            <span class="song-name">The Thrill Is Gone</span>
            <span class="artist-name">B.B. King</span>
          </div>
          <div class="vinyl-animation"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Bento Grid 文章列表 -->
<section class="bento-grid">
  <% var postIndex = 0; %>
  <% page.posts.each(function(post, i){ %>
    <% 
      var cardType = 'normal';
      var cardClass = 'bento-item';
      
      // 第一篇为 Feature Post (2x2)
      if (i === 0) {
        cardType = 'feature';
        cardClass += ' bento-feature';
      }
      // 技术类文章 (1x1)
      else if (post.categories && post.categories.length && 
               (post.categories.toArray().some(c => ['技术', 'Tech', 'Code', '编程'].includes(c.name)))) {
        cardType = 'tech';
        cardClass += ' bento-tech';
      }
      // 随笔类 (1x2)
      else if (post.categories && post.categories.length && 
               (post.categories.toArray().some(c => ['随笔', 'Essay', '思考', '生活'].includes(c.name)))) {
        cardType = 'essay';
        cardClass += ' bento-essay';
      }
      // 默认 (1x1)
      else {
        cardClass += ' bento-normal';
      }
    %>
    
    <article class="<%= cardClass %>" data-type="<%= cardType %>">
      <% if (cardType === 'feature' && post.cover) { %>
        <div class="bento-cover" style="background-image: url('<%= post.cover %>')"></div>
      <% } %>
      
      <% if (cardType === 'tech') { %>
        <div class="tech-badge">
          <span class="lang-tag">C++</span>
        </div>
        <div class="code-texture"></div>
      <% } %>
      
      <div class="bento-content">
        <div class="bento-meta">
          <time class="post-date"><%= date(post.date, 'YYYY.MM.DD') %></time>
          <% if (post.categories && post.categories.length) { %>
            <span class="post-category"><%= post.categories.toArray()[0].name %></span>
          <% } %>
        </div>
        
        <h2 class="bento-title">
          <a href="<%- url_for(post.path) %>"><%= post.title %></a>
        </h2>
        
        <% if (cardType === 'feature' || cardType === 'essay') { %>
          <p class="bento-excerpt">
            <%= strip_html(post.excerpt || post.content).substring(0, cardType === 'feature' ? 200 : 120) %>...
          </p>
        <% } %>
        
        <% if (post.tags && post.tags.length) { %>
          <div class="bento-tags">
            <% post.tags.toArray().slice(0, 3).forEach(function(tag){ %>
              <a href="<%- url_for(tag.path) %>" class="tag"><%= tag.name %></a>
            <% }); %>
          </div>
        <% } %>
      </div>
      
      <a href="<%- url_for(post.path) %>" class="bento-link" aria-label="Read <%= post.title %>"></a>
    </article>
  <% }); %>
</section>

<!-- 分页 -->
<%- partial('_partial/pagination') %>
