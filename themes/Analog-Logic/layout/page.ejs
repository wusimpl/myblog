<article class="page-detail">
  <header class="page-header">
    <h1 class="page-title"><%= page.title %></h1>
  </header>

  <% if (page.layout === 'about' || page.path.includes('about')) { %>
    <!-- About 页面特殊布局 -->
    <div class="about-content">
      <!-- Profile Widget -->
      <div class="profile-widget">
        <div class="profile-avatar">
          <img src="<%- url_for(theme.avatar || '/images/icon.png') %>" alt="<%= theme.author %>">
          <div class="vinyl-ring"></div>
        </div>
        
        <h2 class="profile-name"><%= theme.author %></h2>
        <p class="profile-bio"><%= theme.bio %></p>
        
        <div class="profile-links">
          <% if (theme.social && theme.social.github) { %>
            <a href="<%= theme.social.github %>" target="_blank" class="social-link" title="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
          <% } %>
          <% if (theme.social && theme.social.music) { %>
            <a href="<%= theme.social.music %>" target="_blank" class="social-link" title="Music">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            </a>
          <% } %>
          <% if (theme.social && theme.social.email) { %>
            <a href="<%= theme.social.email %>" class="social-link" title="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </a>
          <% } %>
        </div>
      </div>
      
      <div class="about-text">
        <%- page.content %>
      </div>
    </div>
  <% } else { %>
    <!-- 普通页面 -->
    <div class="page-content">
      <%- page.content %>
    </div>
  <% } %>
</article>
