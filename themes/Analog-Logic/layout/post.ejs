<article class="post-detail">
  <!-- 文章头部 -->
  <header class="post-header">
    <div class="post-meta-top">
      <time class="post-date"><%= date(page.date, 'YYYY.MM.DD') %></time>
      <% if (page.categories && page.categories.length) { %>
        <span class="meta-divider">·</span>
        <% page.categories.each(function(cat){ %>
          <a href="<%- url_for(cat.path) %>" class="post-category"><%= cat.name %></a>
        <% }); %>
      <% } %>
    </div>
    
    <h1 class="post-title"><%= page.title %></h1>
    
    <% if (page.tags && page.tags.length) { %>
      <div class="post-tags">
        <% page.tags.each(function(tag){ %>
          <a href="<%- url_for(tag.path) %>" class="tag"><%= tag.name %></a>
        <% }); %>
      </div>
    <% } %>
  </header>

  <!-- 侧边目录 (IDE Outline 风格) -->
  <% if (theme.post.toc && page.toc) { %>
  <aside class="toc-sidebar" id="tocSidebar">
    <div class="toc-header">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
      <span>OUTLINE</span>
    </div>
    <nav class="toc-content">
      <%- toc(page.content, {list_number: false, class: 'toc-list'}) %>
    </nav>
  </aside>
  <% } %>

  <!-- 文章内容 -->
  <div class="post-content">
    <%- page.content %>
  </div>

  <!-- 文章底部 -->
  <footer class="post-footer">
    <div class="post-info">
      <span class="info-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        <%= date(page.date, 'YYYY-MM-DD') %>
      </span>
      <% if (page.updated) { %>
      <span class="info-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        更新于 <%= date(page.updated, 'YYYY-MM-DD') %>
      </span>
      <% } %>
    </div>
  </footer>

  <!-- 文章导航 -->
  <nav class="post-nav">
    <% if (page.prev) { %>
      <a href="<%- url_for(page.prev.path) %>" class="nav-prev">
        <span class="nav-label">← 上一篇</span>
        <span class="nav-title"><%= page.prev.title %></span>
      </a>
    <% } else { %>
      <span class="nav-prev disabled"></span>
    <% } %>
    
    <% if (page.next) { %>
      <a href="<%- url_for(page.next.path) %>" class="nav-next">
        <span class="nav-label">下一篇 →</span>
        <span class="nav-title"><%= page.next.title %></span>
      </a>
    <% } else { %>
      <span class="nav-next disabled"></span>
    <% } %>
  </nav>
</article>
